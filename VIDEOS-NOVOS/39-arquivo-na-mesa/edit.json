   }
  },
  {
   "id": "lg11",
   "type": "text",
   "track": "legenda",
   "label": "O ladrão era Vincenzo Peruggia",
   "start": 34.56,
   "dur": 1.79,
   "by": "template",
   "props": {
    "text": "O ladrão era Vincenzo Peruggia,"
   }
  },
  {
   "id": "lg12",
   "type": "text",
   "track": "legenda",
   "label": "um italiano que tinha trabalha",
