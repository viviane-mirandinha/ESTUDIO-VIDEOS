   "props": {
    "text": "Paris, segunda-feira, 21 de agosto de 1911."
   }
  },
  {
   "id": "lg01",
   "type": "text",
   "track": "legenda",
   "label": "O Louvre está fechado ao públi",
   "start": 4.82,
   "dur": 2.18,
   "by": "template",
   "props": {
    "text": "O Louvre está fechado ao público."
   }
  },
  {
   "id": "lg02",
   "type": "text",
   "track": "legenda",
   "label": "E um homem sai do museu com a ",
   "start": 7.18,
   "dur": 4.72,
   "by": "template",
   "props": {
    "text": "E um homem sai do museu com a Mona Lisa escondida debaixo do avental."
   }
  },
  {
   "id": "lg03",
   "type": "text",
   "track": "legenda",
   "label": "Ninguém percebe.",
   "start": 12.2,
   "dur": 1.1,
   "by": "template",
   "props": {
    "text": "Ninguém percebe."
   }
  },
  {
   "id": "lg04",
   "type": "text",
   "track": "legenda",
   "label": "Só no dia seguinte o pintor Lo",
   "start": 13.46,
   "dur": 3.04,
   "by": "template",
   "props": {
    "text": "Só no dia seguinte o pintor Louis Béroud chega para pintar a sala"
   }
  },
  {
   "id": "lg05",
   "type": "text",
   "track": "legenda",
   "label": "e encontra, no lugar do quadro",
   "start": 16.56,
   "dur": 4.44,
   "by": "template",
   "props": {
    "text": "e encontra, no lugar do quadro, apenas quatro ganchos de ferro na parede."
   }
  },
  {
   "id": "lg06",
   "type": "text",
   "track": "legenda",
   "label": "O museu fecha por uma semana.",
   "start": 21.26,
   "dur": 2.14,
   "by": "template",
   "props": {
    "text": "O museu fecha por uma semana."
   }
  },
  {
   "id": "lg07",
   "type": "text",
   "track": "legenda",
   "label": "A moldura vazia aparece numa e",
   "start": 23.52,
   "dur": 3.08,
   "by": "template",
   "props": {
    "text": "A moldura vazia aparece numa escada do próprio Louvre."
   }
  },
  {
   "id": "lg08",
   "type": "text",
   "track": "legenda",
   "label": "A polícia chega a interrogar P",
   "start": 26.9,
   "dur": 2.4,
   "by": "template",
   "props": {
    "text": "A polícia chega a interrogar Pablo Picasso,"
   }
  },
  {
   "id": "lg09",
   "type": "text",
   "track": "legenda",
   "label": "e o poeta Guillaume Apollinair",
