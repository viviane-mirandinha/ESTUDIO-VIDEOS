author_id": "38770484446", "id": "17942778495097847", "text": "Se lula ganhar, eu vou pra lá...", "timestamp": 1792630460, "like_count": 1}, {"author": "dinho_chagas_23", "author_id": "7789203167", "id": "17869393311663289", "text": "A parte ruim você não mostrar né 😂😂😂", "timestamp": 1792627423, "like_count": 0}, {"author": "_gabriel_silva_li", "author_id": "49378228715", "id": "18026661062875092", "text": "Com certeza EUA", "timestamp": 1792626751, "like_count": 0}, {"author": "japasuperman", "author_id": "75514197030", "id": "18095147459161319", "text": "SIM", "timestamp": 1792621774, "like_count": 0}, {"author": "gabriell.zinho", "author_id": "59771972052", "id": "17889159420477504", "text": "Se ainda pergunta se trocaria", "timestamp": 1792619959, "like_count": 0}], "webpage_url": "https://www.instagram.com/reel/DeolZXGRwBg/", "webpage_url_basename": "DeolZXGRwBg", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "thumbnail": "https://instagram.fpll6-1.fna.fbcdn.net/v/t51.82787-15/852824900_970992375470401_740128719555721573_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=107&_nc_map=urlgen_bucketless&ig_cache_key=NDAxMDYxOTkzODY4MjYzNDMzNjk3MDk5MjM3MjEzNzA2OA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=3F8fguxUoWsQ7kNvwEUQbHt&_nc_oc=AdrD3oKh-dzC-GBLrsElyrGeSa7v71XR82AihcTfWYxXl8sJ5jCyt9LTTEEa8GtItAU&_nc_zt=23&_nc_ht=instagram.fpll6-1.fna&_nc_gid=uIM12vHWYqnqn4HUn36gzg&_nc_ss=7ba8c&oh=00_AQOl_7lysM6cEeRPvqYmHPt7UAghDaEAl2-iqFNgEwSNSg&oe=6AE06147", "display_id": "DeolZXGRwBg", "fulltitle": "Video by minuto_curioso12", "upload_date": "20261018", "epoch": 1792706111, "url": "https://instagram.fpll6-2.fna.fbcdn.net/o1/v/t2/f2/m86/AQMQP0IRO9yX_3pBjlOB7R0oTD9X3NlnOoQ4GvJeDd7i6gz6APOcgwi0Yj3ORZy5A5UT0sDpciecq7Zkl-Cye4MHSSlSLigRUgBwfr0.mp4?_nc_cat=108&_nc_oc=AdpInee-yoxx9NMaUE3DmmDsGYy6xn31JKCg2GWTKW4HR_wwn_HYtIqxym8pUr4mI6k&_nc_sid=5e9